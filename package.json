{
  "name": "html-release-updater",
  "version": "1.0.0",
  "description": "纯本地桌面版 HTML 交互系统 - 软件发布与更新模块",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "dev:electron": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder --dir",
    "build:win": "vue-tsc --noEmit && vite build && electron-builder --win",
    "build:mac": "vue-tsc --noEmit && vite build && electron-builder --mac",
    "build:linux": "vue-tsc --noEmit && vite build && electron-builder --linux",
    "electron:start": "electron .",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "ant-design-vue": "^4.1.2",
    "archiver": "^6.0.1",
    "dexie": "^4.0.1",
    "extract-zip": "^2.0.1",
    "lucide-vue-next": "^0.312.0",
    "md5-file": "^5.0.0",
    "semver": "^7.6.0",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.11.5",
    "@types/semver": "^7.5.6",
    "@vitejs/plugin-vue": "^5.0.3",
    "autoprefixer": "^10.4.17",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "5.4",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.12"
  },
  "build": {
    "appId": "com.geek.html-release-updater",
    "productName": "HTML Release Updater",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  }
}
